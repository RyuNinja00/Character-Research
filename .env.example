# Copy to .env and fill in. Any OpenAI-compatible endpoint works.
# Pick ONE provider block below and remove the "# " in front of its lines.
# Leave LLM_EXTRACT_MODEL out unless you want a second, cheaper model from the SAME provider.

# OpenAI
# LLM_BASE_URL=https://api.openai.com/v1
# LLM_API_KEY=sk-...
# LLM_MODEL=gpt-4o
# LLM_EXTRACT_MODEL=gpt-4o-mini

# Featherless.ai (flat price, uncensored open-weight models – good for --nsfw; use --workers 2 on the Chat plan)
# LLM_BASE_URL=https://api.featherless.ai/v1
# LLM_API_KEY=your-featherless-key
# LLM_MODEL=huihui-ai/Huihui-Qwen3.5-27B-abliterated
# LLM_MAX_TOKENS=6144
# LLM_THINKING=auto        # auto | off | on – reasoning models are asked to answer directly

# OpenRouter
# LLM_BASE_URL=https://openrouter.ai/api/v1
# LLM_API_KEY=sk-or-...
# LLM_MODEL=anthropic/claude-sonnet-4.5

# Anthropic (OpenAI-compatible endpoint)
# LLM_BASE_URL=https://api.anthropic.com/v1
# LLM_API_KEY=sk-ant-...
# LLM_MODEL=claude-sonnet-4-5

# Local: Ollama / LM Studio / KoboldCpp / llama.cpp server
# LLM_BASE_URL=http://localhost:11434/v1
# LLM_MODEL=qwen2.5:14b
# LLM_JSON_MODE=off

# Image generation for --generate-avatar (any OpenAI-compatible /images/generations endpoint)
# IMAGE_BASE_URL=https://api.openai.com/v1
# IMAGE_API_KEY=sk-...
# IMAGE_MODEL=gpt-image-1

# Audio transcription (Featherless has no audio models). Easiest: pip install faster-whisper (local, private).
# Or an OpenAI-compatible transcription API:
# TRANSCRIBE_BASE_URL=https://api.groq.com/openai/v1
# TRANSCRIBE_API_KEY=gsk_...
# TRANSCRIBE_MODEL=whisper-large-v3
# WHISPER_MODEL=small
# WHISPER_DEVICE=auto      # auto (GPU if it works, else CPU) | cpu | cuda

# Web search (optional; DuckDuckGo is used when none is set)
# SEARCH_PROVIDER=auto
# TAVILY_API_KEY=
# BRAVE_API_KEY=
# SEARXNG_URL=http://localhost:8080

# Reddit public feeds: only needed if Reddit refuses anonymous reading.
# Free "script" app at reddit.com/prefs/apps (read-only, public posts).
# REDDIT_CLIENT_ID=
# REDDIT_CLIENT_SECRET=

# Marinara Engine login (only if your server has one)
# MARINARA_USER=
# MARINARA_PASS=

# CARD_CREATOR=YourName
